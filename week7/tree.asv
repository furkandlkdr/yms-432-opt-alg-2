classificationTree = fitctree(...
    Egitim, ...
    Egitimc, ...
    'SplitCriterion', 'gdi', ...
    'MaxNumSplits', 100, ...
    'Surrogate', 'off', ...
    'ClassNames', [0; 1]);

Test_tahmin_tree=predict(classificationTree,Test);

plotconfusion(Test_tahmin_tree,Testc);
rng('default')